{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ETL_Tool_Dev;Integrated Security=true;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "EnableSensitiveDataLogging": true,
    "CommandTimeout": 30
  },
  "Hangfire": {
    "WorkerCount": 2,
    "Queues": [ "etl", "default" ],
    "RetryAttempts": 3,
    "RetryDelayInSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
