{
  "name": "etl-pipeline-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "format": "dotnet csharpier format $(find . -name '*.cs' -not -path './ETLPipelineTool.IntegrationTest/*')",
    "format:check": "dotnet csharpier --check $(find . -name '*.cs' -not -path './ETLPipelineTool.IntegrationTest/*')"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  }
}